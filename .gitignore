# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code local settings (may contain API tokens)
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.qodo

# local scratch space (debug scripts, screenshots)
/tmp/
/gozbebekleri
/Minbar

# integration test build output
/.integration-test-build/

# Prisma generated clients. `prisma generate` recreates these, and the query
# engine is a ~20MB platform-specific binary (the Windows build here) that is
# wrong for any other machine anyway.
/generated/
