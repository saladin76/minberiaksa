{
  "crons": [
    {
      "path": "/api/cron/exchange-rates",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/marketing-platform-sync",
      "schedule": "15 */3 * * *"
    },
    {
      "path": "/api/cron/communication-run-due",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/communication-sync-email-events",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/communication-sync-whatsapp-templates",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/donation-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reconcile-donations",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/recurring-charges",
      "schedule": "*/15 * * * *"
    }
  ],
  "installCommand": "npm ci --prefer-offline --no-audit --no-fund",
  "buildCommand": "npm run build:vercel",
  "github": {
    "autoJobCancelation": true
  }
}
