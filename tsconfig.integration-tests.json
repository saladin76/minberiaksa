{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".integration-test-build",
    "rootDir": ".",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "types/next-auth.d.ts",
    "types/pdf-parse.d.ts",
    "lib/integration-settings/active-test-core.ts",
    "lib/integration-settings/api-contracts.ts",
    "lib/integration-settings/brevo-webhook.ts",
    "lib/integration-settings/provider-webhook.ts",
    "lib/integration-settings/canonical-url.ts",
    "lib/integration-settings/catalog.ts",
    "lib/integration-settings/validation.ts",
    "lib/integration-settings/crypto.ts",
    "lib/integration-settings/helpers.ts",
    "lib/integration-settings/provider-testing/**/*.ts",
    "lib/integration-settings/release-readiness.ts",
    "lib/integration-settings/resolver.ts",
    "lib/integration-settings/runtime-policy.ts",
    "lib/integration-settings/service.ts",
    "lib/integration-settings/types.ts",
    "lib/integration-settings/ui-contracts.ts",
    "lib/integration-settings/ui-lifecycle.ts",
    "lib/communication/cron-auth.ts",
    "lib/communication/communication-runtime-types.ts",
    "lib/communication/delivery-status-progress.ts",
    "lib/communication/providers/elastic-email/errors.ts",
    "lib/communication/providers/elastic-email/payload.ts",
    "lib/communication/providers/elastic-email/types.ts",
    "lib/communication/providers/elastic-email/webhook-events.ts",
    "lib/communication/providers/netgsm/errors.ts",
    "lib/dashboard/permissions.ts",
    "lib/dashboard/nav-config.ts",
    "lib/dashboard/page-access.ts",
    "lib/dashboard/page-permission.ts",
    "lib/dashboard/user-demographics.ts",
    "lib/blog/admin-editor-data-core.ts",
    "lib/campaign/admin-create-core.ts",
    "lib/bank-transfers/amount-format.ts",
    "lib/bank-transfers/statement-columns.ts",
    "lib/bank-transfers/statement-parser.ts",
    "lib/locales.ts",
    "lib/content-localization/access.ts",
    "tests/integration-settings/**/*.ts"
  ]
}
