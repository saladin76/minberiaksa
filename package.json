    "dev": "next dev",
    "build": "npm run test:integration-settings && prisma generate && prisma generate --schema prisma/integration-settings.schema.prisma && npm run typecheck:communication-runtime && npm run typecheck:integration-release && TSC_COMPILE_ON_ERROR=true next build",
    "start": "next start",
    "lint": "next lint",
    "test:integration-settings": "rm -rf .integration-test-build && tsc -p tsconfig.integration-tests.json && node --test .integration-test-build/tests/integration-settings/*.test.js",
    "typecheck:communication-runtime": "tsc -p tsconfig.communication-runtime.json",
    "typecheck:integration-release": "tsc -p tsconfig.integration-release.json",
    "preflight:integration-settings": "prisma generate --schema prisma/integration-settings.schema.prisma && tsx scripts/preflight-integration-settings.ts",
    "verify:integration-settings-migration": "prisma generate --schema prisma/integration-settings.schema.prisma && tsx scripts/verify-integration-settings-migration.ts",
    "dashboard:schema:validate": "prisma validate --schema prisma/dashboard-foundation.schema.prisma",
    "i18n:audit": "node scripts/audit-i18n-messages.mjs",
    "i18n:audit:strict": "node scripts/audit-i18n-messages.mjs --strict",
    "locale:audit": "node scripts/audit-locales.mjs",
    "locale:audit:strict": "node scripts/audit-locales.mjs --strict",
    "content:audit": "node scripts/audit-content-localization.mjs",
    "content:audit:strict": "node scripts/audit-content-localization.mjs --strict",
    "backfill:slugs": "tsx prisma/backfill-slugs.ts",
    "backfill:donation-countries": "tsx scripts/backfill-donation-donor-country.ts",
    "backfill:monthly-paid": "tsx scripts/backfill-stripe-monthly-paid.ts",
    "exchange-rates:refresh": "tsx scripts/refresh-exchange-rates.ts",
    "cleanup:orphan-donation-items": "tsx scripts/cleanup-orphan-donation-items.ts",
    "migrate:integration-settings": "prisma generate --schema prisma/integration-settings.schema.prisma && tsx prisma/mongodb-migrations/20260714-integration-settings.ts"
  },
