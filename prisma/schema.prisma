/**
 * ===================== MESSAGE TEMPLATES (admin outreach) =====================
 */

model EmailTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  /// Canonical Arabic subject (also the fallback when a locale variation is missing).
  subject      String
  /// Canonical Arabic TReaderDocument JSON from @usewaypoint/email-builder.
  document     Json
  /// Per-locale overrides: Record<locale, { subject?: string; document?: TReaderDocument }>.
  /// Locales not present here fall back to the canonical Arabic subject/document.
  translations Json?
  createdById  String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Template Center taxonomy (all optional / defaulted for back-compat)
  /// "SYSTEM" (platform-event templates) | "CAMPAIGN" (reusable marketing). Unset = CAMPAIGN.
  kind      String? @default("CAMPAIGN")
  /// "DRAFT" | "READY" | "NEEDS_REVIEW" | "ARCHIVED". Unset = DRAFT.
  status    String? @default("DRAFT")
  /// "MARKETING" | "UTILITY" | "TRANSACTIONAL" | "AUTHENTICATION" (optional).
  purpose   String?
  /// Short pre-header line shown after the subject in inboxes (optional).
  preheader String?
  /// Optional reusable EmailLayout this template renders inside (additive — the
  /// existing @usewaypoint `document` path is unaffected when this is null).
  layoutId  String? @db.ObjectId
  /// Content-mode fields for the layout builder: Record<locale, { title?, body?, ctaText?, ctaUrl?, footerNote? }>.
  content   Json?

  @@index([name])
  @@index([kind])
}

/// Reusable fixed email layout (shell) that many email templates render inside.
/// Additive — does not replace the @usewaypoint document pipeline; it powers the
/// new content-based Template Center email builder.
model EmailLayout {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  description            String?
  /// HTML shell containing a `{{content}}` slot where the template body is injected.
  htmlShell              String
  /// Token used inside htmlShell for the content slot (default "{{content}}").
  contentSlot            String   @default("{{content}}")
  headerHtml             String?
  footerHtml             String?
  ctaSection             String?
  /// Whether an unsubscribe placeholder must be present (marketing layouts).
  unsubscribePlaceholder Boolean  @default(false)
  /// "DRAFT" | "READY" | "ARCHIVED".
  status                 String   @default("DRAFT")
  isDefault              Boolean  @default(false)
  createdById            String?  @db.ObjectId
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status])
}

model WhatsappTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  /// Canonical Arabic body (also the fallback when a locale variation is missing).
  body         String
  /// Per-locale overrides: Record<locale, { body?: string }>.
  translations Json?
  createdById  String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Twilio / WhatsApp Content metadata (all optional for back-compat)
  /// "TWILIO" when imported from Twilio Content API, "MANUAL" otherwise.
  provider           String?
  /// "WHATSAPP" — kept explicit for the future Marketing Intelligence module.
  channel            String?
  /// Twilio Content SID (HX-prefixed) or other provider id.
  externalTemplateId String?
  /// "text" | "media" | "card" | "quick_reply" | "call_to_action" | "list_picker" | "location"
  templateType       String?
  /// IETF language tag, e.g. "ar", "en".
  language           String?
  /// WhatsApp template category — MARKETING / UTILITY / AUTHENTICATION (etc.)
  category           String?
  /// "approved" | "pending" | "rejected" | "unknown" — Twilio whatsapp/approval state.
  approvalStatus     String?
  /// Header descriptor when the template has a header.
  /// Shape: { type, text?, mediaUrl?, mediaSid?, mimeType?, fileName?, previewUrl?, latitude?, longitude?, address? }
  header             Json?
  footerText         String?
  /// Buttons array. Shape: Array<{ type, text, url?, phoneNumber?, payload?, index }>
  /// type ∈ "url" | "phone" | "quick_reply" | "copy_code" | "donation_cta" | "tracking_url".
  buttons            Json?
  /// Template variable catalog. Shape: Array<{ key, exampleValue?, mapping?, validationStatus? }>
  variables          Json?
  /// Last successful sync from Twilio.
  lastImportedAt     DateTime?
  /// "ok" | "missing_config" | "not_implemented" | "failed"
  lastSyncStatus     String?
  /// Last error message from sync (truncated, never includes auth tokens).
  lastSyncError      String?
  /// Sanitized provider payload — handy for debugging mapping issues.
  providerRaw        Json?

  // ── Template Center taxonomy (optional / defaulted for back-compat)
  /// "SYSTEM" (platform-event) | "CAMPAIGN" (reusable marketing). Unset = CAMPAIGN.
  kind    String? @default("CAMPAIGN")
  /// "DRAFT" | "READY" | "NEEDS_REVIEW" | "ARCHIVED". Unset = DRAFT.
  status  String? @default("DRAFT")
  /// "MARKETING" | "UTILITY" | "TRANSACTIONAL" | "AUTHENTICATION" (optional).
  purpose String?

  @@index([name])
  @@index([externalTemplateId])
  @@index([provider])
  @@index([kind])
}

/// Plain-text templates for the SMS channel.
///
/// Deliberately its own collection rather than a flag on WhatsappTemplate, which is what SMS
/// borrowed before. The two channels look similar (a text body plus per-locale overrides) but are
/// authored against opposite constraints: a WhatsApp template carries a header, footer, buttons and
/// a Meta approval lifecycle and may run to 4096 characters, while an SMS is bare text billed per
/// 70-character segment in Arabic. One shared body forces a choice between a needlessly terse
/// WhatsApp message and an SMS that silently costs five segments — and it also made SMS-only drafts
/// surface in the WhatsApp list as unapproved WhatsApp templates.
model SmsTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  /// Canonical Arabic body (also the fallback when a locale variation is missing).
  body         String
  /// Per-locale overrides: Record<locale, { body?: string }>.
  translations Json?
  createdById  String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ── Template Center taxonomy, mirroring EmailTemplate / WhatsappTemplate.
  /// "SYSTEM" (platform-event) | "CAMPAIGN" (reusable marketing). Unset = CAMPAIGN.
  kind    String? @default("CAMPAIGN")
  /// "DRAFT" | "READY" | "NEEDS_REVIEW" | "ARCHIVED". Unset = DRAFT.
  status  String? @default("DRAFT")
  /// "MARKETING" | "UTILITY" | "TRANSACTIONAL" | "AUTHENTICATION" (optional).
  purpose String?

  @@index([name])
  @@index([kind])
}

enum MessageTriggerEvent {
  DONATION_PAID
  DONATION_FAILED
  FIRST_DONATION
  USER_REGISTERED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_PAYMENT
  SUBSCRIPTION_CANCELLED
  /// Scheduled (not event-driven): the donor's last PAID donation is older than `lapseDays`.
  /// Evaluated daily by /api/cron/donation-reminders — see lib/events/donation-lapsed.ts.
  DONATION_LAPSED
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

model MessageTrigger {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  event        MessageTriggerEvent
  channel      MessageChannel
  /// Refers to EmailTemplate.id when channel=EMAIL, WhatsappTemplate.id when channel=WHATSAPP
  templateId   String              @db.ObjectId
  enabled      Boolean             @default(true)
  /// DONATION_LAPSED only — days since the donor's last PAID donation before the reminder fires.
  lapseDays    Int?
  /// DONATION_LAPSED only — minimum days before the same donor may be reminded again.
  cooldownDays Int?
  createdById  String?             @db.ObjectId
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([event, enabled])
  @@index([templateId])
}

enum SentMessageStatus {
  SENT // accepted by provider
  FAILED // provider rejected or threw
  SKIPPED // recipient missing email/phone
}

enum SentMessageOrigin {
  MANUAL // admin clicked send from dashboard
  TRIGGER // auto-fired by event dispatcher
  BACKFILL // imported from legacy audit logs (no per-recipient detail)
}

/// Per-recipient log of every templated email or WhatsApp message that goes out.
/// Stores the rendered subject/body and a snapshot of the variables so the
/// dashboard history page can show exactly what was sent to each person.
model SentMessage {
  id      String            @id @default(auto()) @map("_id") @db.ObjectId
  channel MessageChannel
  origin  SentMessageOrigin
  status  SentMessageStatus

  // Template snapshot — templateId may point to a deleted template, so we also store the name.
  templateId   String?              @db.ObjectId
  templateName String
  triggerEvent MessageTriggerEvent? // set when origin=TRIGGER
  locale       String

  // Recipient
  recipientUserId String? @db.ObjectId
  recipientEmail  String?
  recipientPhone  String?
  recipientName   String?

  // Rendered content (HTML for email, plain text for WhatsApp)
  renderedSubject String?
  renderedBody    String
  /// Snapshot of the TemplateContext used to merge variables.
  variables       Json?

  // Result
  errorMessage      String?
  providerMessageId String?

  // Audit
  actorId    String? @db.ObjectId
  actorName  String?
  donationId String? @db.ObjectId

  // Backfill summary aggregates — only populated when origin=BACKFILL.
  /// Total recipients reported by the source audit log (manual bulk send).
  backfillTotal   Int?
  backfillSent    Int?
  backfillFailed  Int?
  backfillSkipped Int?

  createdAt DateTime @default(now())

  @@index([channel, createdAt(sort: Desc)])
  @@index([templateId])
  @@index([recipientUserId])
  @@index([status])
  @@index([origin])
  @@index([triggerEvent])
  @@index([createdAt(sort: Desc)])
}

