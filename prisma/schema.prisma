model OperationTask {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String?
  taskType          String
  status            String    @default("PENDING")
  priority          String    @default("MEDIUM")
  assignedTo        String?   @db.ObjectId
  contentItemId     String?   @db.ObjectId
  planId            String?   @db.ObjectId
  seasonId          String?   @db.ObjectId
  sourceType        String?
  sourceId          String?   @db.ObjectId
  dueAt             DateTime?
  startedAt         DateTime?
  reviewRequestedAt DateTime?
  completedAt       DateTime?
  approvedAt        DateTime?
  blockedReason     String?
  qualityRating     Int?
  workloadScore     Int?
  resultNotes       String?
  createdBy         String?   @db.ObjectId
  updatedBy         String?   @db.ObjectId
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([taskType])
  @@index([assignedTo])
  @@index([contentItemId])
  @@index([sourceType, sourceId])
  @@index([dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION CENTER RUNTIME (Package 1 — data foundation, no real sending)
// Channel/provider/status/purpose/origin use String fields (not Prisma enums) so
// the lifecycle can evolve safely on MongoDB. Allowed values are documented inline.
// New archive layer: CommunicationDelivery. Legacy SentMessage is preserved untouched.
// ─────────────────────────────────────────────────────────────────────────────

model CommunicationSender {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  channel            String // WHATSAPP | EMAIL | SMS
  provider           String // META_WHATSAPP | TWILIO | SENDGRID | NETGSM | CUSTOM
  name               String
  displayName        String?
  phoneNumberId      String? // Meta WhatsApp Cloud API phone number id
  displayPhoneNumber String?
  businessAccountId  String?
  senderEmail        String?
  smsSender          String?
  supportedLocales   String[]
  supportedCountries String[]
  supportedPurposes  String[] // MARKETING | UTILITY | TRANSACTIONAL | AUTHENTICATION
  qualityRating      String?
  status             String    @default("NOT_CONFIGURED") // ACTIVE | DISABLED | NEEDS_ATTENTION | NOT_CONFIGURED
  isDefault          Boolean   @default(false)
  enabled            Boolean   @default(false)
  priority           Int       @default(100)
  lastHealthCheckAt  DateTime?
  lastError          String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([channel, enabled])
  @@index([provider])
}

model SenderRoutingRule {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  channel          String // WHATSAPP | EMAIL | SMS
  locale           String?
  country          String?
  purpose          String? // MARKETING | UTILITY | TRANSACTIONAL | AUTHENTICATION
  senderId         String   @db.ObjectId
  fallbackSenderId String?  @db.ObjectId
  priority         Int      @default(100)
  enabled          Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([channel, enabled])
}

model DonorCommunicationProfile {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @unique @db.ObjectId
  preferredLocale     String?
  countryCode         String?
  timezone            String?
  phone               String?
  email               String?
  whatsappOptIn       Boolean   @default(false) // no explicit WhatsApp consent field on User → stays false until confirmed
  emailOptIn          Boolean   @default(false)
  smsOptIn            Boolean   @default(false)
  doNotContact        Boolean   @default(false)
  consentSource       String?
  lastConsentAt       DateTime?
  lastDonationAt      DateTime?
  totalDonations      Int       @default(0)
  lastCommunicationAt DateTime?
  lastWhatsappAt      DateTime?
  lastEmailAt         DateTime?
  lastSmsAt           DateTime?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([preferredLocale])
  @@index([countryCode])
}

model CommunicationCampaign {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  channel            String // WHATSAPP | EMAIL | SMS
  purpose            String    @default("MARKETING") // MARKETING | UTILITY | TRANSACTIONAL | AUTHENTICATION
  audienceSegmentKey String?
  templateGroupId    String?
  senderRoutingMode  String    @default("AUTO") // AUTO | FIXED
  status             String    @default("DRAFT") // DRAFT | REVIEW | APPROVED | SCHEDULED | SENDING | SENT | CANCELLED | FAILED
  scheduledAt        DateTime?
  approvedBy         String?   @db.ObjectId
  approvedAt         DateTime?
  sentCount          Int       @default(0)
  deliveredCount     Int       @default(0)
  readCount          Int       @default(0)
  failedCount        Int       @default(0)
  repliedCount       Int       @default(0)
  clickedCount       Int       @default(0)
  donationCount      Int       @default(0)
  revenue            Float     @default(0)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([channel, status])
  @@index([status])
}

model CommunicationDelivery {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  channel                String // WHATSAPP | EMAIL | SMS
  provider               String? // META_WHATSAPP | TWILIO | SENDGRID | NETGSM | CUSTOM
  senderId               String?   @db.ObjectId
  campaignId             String?   @db.ObjectId
  templateId             String?
  templateName           String?
  recipientUserId        String?   @db.ObjectId
  recipientPhone         String?
  recipientEmail         String?
  recipientName          String?
  locale                 String?
  purpose                String    @default("TRANSACTIONAL") // MARKETING | UTILITY | TRANSACTIONAL | AUTHENTICATION
  origin                 String    @default("SYSTEM") // MANUAL | CAMPAIGN | TRIGGER | TEST | REACTIVATION | SYSTEM
  // Lifecycle: DRAFT | QUEUED | RENDERED | SKIPPED | SENT_TO_PROVIDER | SENT |
  // DELIVERED | READ | OPENED | CLICKED | REPLIED | FAILED | BOUNCED | UNSUBSCRIBED | CANCELLED
  status                 String    @default("DRAFT")
  renderedSubject        String?
  renderedBody           String?
  variables              Json?
  providerMessageId      String?
  providerConversationId String?
  errorMessage           String?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  readAt                 DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  repliedAt              DateTime?
  failedAt               DateTime?
  // Retry linkage. A retry is a NEW row pointing back at the attempt it re-sends, never an edit of
  // the original: the first failure is evidence, and rewriting it would silently move the historical
  // failure-rate figures. `retriedAt` is stamped on the ORIGINAL once a retry actually reaches the
  // provider, which is what stops the same message being sent twice.
  // Both are optional — MongoDB documents written before this existed have neither field, and a
  // required column would make every one of them unreadable.
  retryOfDeliveryId      String?   @db.ObjectId
  retriedAt              DateTime?
  createdBy              String?   @db.ObjectId
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([campaignId])
  @@index([channel, status])
  @@index([recipientUserId])
  @@index([providerMessageId])
}

model CommunicationProviderEvent {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  deliveryId        String?   @db.ObjectId
  channel           String
  provider          String
  eventType         String
  providerMessageId String?
  senderId          String?   @db.ObjectId
  recipient         String?
  payloadSanitized  Json?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  status            String?
  errorMessage      String?
  idempotencyKey    String    @unique
  createdAt         DateTime  @default(now())

  @@index([deliveryId])
  @@index([providerMessageId])
}

/// A reusable audience list — a custom manual list or a TEST list used to try
/// campaigns/templates before real sending. Automatic language segments are computed live and are
/// NOT stored here. Never seeded with demo data.
model CommunicationAudienceList {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String?
  /// "CUSTOM" | "TEST".
  type          String   @default("CUSTOM")
  /// "ACTIVE" | "ARCHIVED".
  status        String   @default("ACTIVE")
  locale        String?
  /// Channels this list targets: any of "WHATSAPP" | "EMAIL" | "SMS".
  channels      String[]
  createdBy     String?  @db.ObjectId
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  metadata      Json?

  @@index([type, status])
  @@index([status])
}

/// One member of a CommunicationAudienceList. DONOR members reference a real User (contact data is
/// read live from the donor). TEST_CONTACT members hold ad-hoc contact info used ONLY for test sends
/// — they never become donors and never appear in donation reports or normal donor counts.
model CommunicationAudienceMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  listId      String   @db.ObjectId
  userId      String?  @db.ObjectId
  /// "DONOR" | "TEST_CONTACT".
  contactType String   @default("DONOR")
  name        String?
  email       String?
  phone       String?
  locale      String?
  /// "ACTIVE" | "REMOVED".
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listId, status])
  @@index([userId])
}

/// Associates a CommunicationCampaign with a real tracking link (from the existing Link Generator /
/// MarketingCampaignLink collection) so donations can be attributed back to the campaign via the
/// donation `attribution` UTM snapshot. Never fabricates attribution — it only records the link + the
/// UTM values used, and reports match real donations against them.
model CommunicationCampaignTrackingLink {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId  String   @db.ObjectId
  /// Id / urlHash of the underlying MarketingCampaignLink (raw collection), when created via the generator.
  linkId      String?
  url         String
  /// "whatsapp" | "email" | "sms" — auto-selected from the campaign channel.
  source      String
  medium      String   @default("communication")
  /// The value used as utm_campaign (the CommunicationCampaign id) — the campaign-level match key.
  utmCampaign String
  locale      String?
  templateId  String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdBy   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  metadata    Json?

  @@index([campaignId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Site content models.
//
// These replace the static modules under `lib/minbar/content/` and
// `lib/minbar/banks.ts`, each of which carries a `[DASHBOARD-INTEGRATION]` note
// naming the model that takes it over. Until a model holds rows the page keeps
// reading its static list, so adding the schema changes nothing on its own.
//
// Conventions follow the rest of this file exactly: ObjectId ids, timestamps on
// the parent only, a sibling *Translation per translatable model keyed
// @@unique([<parent>Id, locale]) and cascading from it, and `slug` unique on the
// parent. Arabic is the master copy and lives on the parent row; the translation
// table holds every other locale.
// ─────────────────────────────────────────────────────────────────────────────

enum PlaylistKind {
  PROGRAM
  SERIES
}

enum VideoType {
  ACHIEVEMENT
  ENDORSEMENT
  FIELD
}

/// Homepage story rail.
///
/// `startsAt`/`endsAt` are a publishing window, not decoration: a story outside
/// its window is not returned. Both are nullable because "runs forever" has to
/// be expressible — that is the dashboard's unlimited option, stored as
/// `endsAt = null` rather than a sentinel date far in the future. The 24-hour
/// default is applied when a story is created, not here: Prisma defaults are
/// static, so `now() + 24h` cannot be a schema default and belongs in the
/// create path.
///
/// A story is the tapped circle in the homepage rail; what it opens is its
/// slides, shown full-screen one after another the way Instagram does. The
/// cover `image` is only the ring — the content lives on StorySlide.
model Story {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  slug     String    @unique
  title    String
  /// Ring thumbnail. Not shown inside the viewer.
  image    String
  order    Int       @default(0)
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  translations StoryTranslation[]
  slides       StorySlide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model StoryTranslation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  storyId String @db.ObjectId
  locale  String
  title   String

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, locale])
}

enum StoryMediaType {
  IMAGE
  VIDEO
}

/// Where a slide's button leads. Stored as a KIND plus a VALUE rather than a
/// finished href, because the href depends on who is looking: a campaign has a
/// different slug per locale, a page has a localised path, and the visitor's
/// language is only known at request time. The public API resolves it then.
///   PAGE     → value is a MinbarRoute key ("zakat", "projects", …)
///   CAMPAIGN → value is a Campaign id
///   POST     → value is a Post id
///   URL      → value is an href; a site-relative one gets the locale prefix
enum StoryCtaKind {
  PAGE
  CAMPAIGN
  POST
  URL
}

/// One full-screen frame inside a story. Slides are replaced wholesale when a
/// story is saved — the dashboard posts the list, the route swaps it — so
/// `order` is always the array position and never has gaps.
model StorySlide {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  storyId         String         @db.ObjectId
  mediaType       StoryMediaType @default(IMAGE)
  mediaUrl        String
  /// How long an IMAGE slide stays up. A VIDEO slide runs to its end instead.
  durationSeconds Int            @default(5)
  caption         String?
  ctaLabel        String?
  ctaKind         StoryCtaKind?
  ctaValue        String?
  order           Int            @default(0)

  story        Story                   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  translations StorySlideTranslation[]

  @@index([storyId, order])
}

/// Only the words translate; the media and the CTA target are the same for
/// every language.
model StorySlideTranslation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  slideId  String  @db.ObjectId
  locale   String
  caption  String?
  ctaLabel String?

  slide StorySlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, locale])
}

/// "برامجنا المصورة" — a YouTube playlist or series, with its episodes.
model VideoPlaylist {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  slug               String       @unique
  title              String
  description        String?
  youtubePlaylistUrl String?
  kind               PlaylistKind @default(PROGRAM)
  coverImage         String?
  order              Int          @default(0)
  isActive           Boolean      @default(true)

  translations PlaylistTranslation[]
  videos       PlaylistVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model PlaylistTranslation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  playlistId  String  @db.ObjectId
  locale      String
  title       String
  description String?

  playlist VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, locale])
}

/// One episode inside a playlist.
///
/// Episode titles are not translated: they are the titles YouTube itself serves,
/// and a translated title that does not match what the viewer reads on the video
/// is worse than an untranslated one.
model PlaylistVideo {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  playlistId      String  @db.ObjectId
  youtubeId       String
  url             String
  thumbnail       String?
  title           String?
  durationSeconds Int?
  order           Int     @default(0)
  isActive        Boolean @default(true)

  playlist VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId, order])
}

/// Course or seminar. Stated rather than inferred from the title — the handoff
/// tested whether the Arabic title starts with "ندوة", which stops being true
/// the moment the title is translated.
enum CourseKind {
  COURSE
  SEMINAR
}

/// "دوراتنا".
///
/// Three shapes of course exist and the flags keep them apart: one with a full
/// detail page (`hasDetailPage`), one that only opens its intro video, and one
/// hosted elsewhere (`isExternal` + `externalUrl`). `isPinned` leads the
/// homepage rail — which course is pinned is the foundation's editorial call,
/// so it belongs in data rather than in code.
model Course {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  slug          String     @unique
  title         String
  description   String?
  kind          CourseKind @default(COURSE)
  coverImage    String?
  introVideoId  String?
  introVideoUrl String?
  unitsCount    Int?
  isPinned      Boolean    @default(false)
  isExternal    Boolean    @default(false)
  externalUrl   String?
  hasDetailPage Boolean    @default(false)
  order         Int        @default(0)
  isActive      Boolean    @default(true)

  translations CourseTranslation[]
  videos       CourseVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, isPinned, order])
}

model CourseTranslation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String  @db.ObjectId
  locale      String
  title       String
  description String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, locale])
}

model CourseVideo {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String  @db.ObjectId
  youtubeId String
  url       String
  thumbnail String?
  title     String?
  order     Int     @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

/// Standalone videos — "إنجازاتنا" and "تزكياتنا".
///
/// `localeFilter` restricts a video to specific locales; empty means every
/// locale. It exists because the Turkish endorsements are spoken in Turkish and
/// subtitled nowhere, so showing them to an Arabic or French visitor offers a
/// testimonial that visitor cannot follow.
///
/// `startSeconds` lets one long recording be published as several entries that
/// each open at their own moment.
model Video {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  slug         String    @unique
  type         VideoType
  title        String
  youtubeId    String?
  url          String?
  startSeconds Int?
  thumbnail    String?
  regionKey    String?
  localeFilter String[]  @default([])
  showOnHome   Boolean   @default(false)
  order        Int       @default(0)
  isActive     Boolean   @default(true)

  translations VideoTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive, order])
}

model VideoTranslation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  videoId String @db.ObjectId
  locale  String
  title   String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, locale])
}

/// "التقارير" — published PDF reports.
model Report {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  title       String
  description String?
  fileUrl     String
  coverImage  String?
  year        Int?
  order       Int     @default(0)
  isPublished Boolean @default(true)

  translations ReportTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, year, order])
}

model ReportTranslation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  reportId    String  @db.ObjectId
  locale      String
  title       String
  description String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, locale])
}

/// "كتيبات المؤسسة".
model Booklet {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slug        String  @unique
  title       String
  description String?
  /// Shown under the title in the author's own script; not translated.
  author      String?
  fileUrl     String
  coverImage  String?
  order       Int     @default(0)
  isPublished Boolean @default(true)

  translations BookletTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, order])
}

model BookletTranslation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  bookletId   String  @db.ObjectId
  locale      String
  title       String
  description String?

  booklet Booklet @relation(fields: [bookletId], references: [id], onDelete: Cascade)

  @@unique([bookletId, locale])
}

/// Bank accounts for the bank-transfer donation path.
///
/// `locales` publishes an account only to the languages it is meant for: a
/// Turkish donor and a Gulf donor should not be handed the same IBAN. Empty
/// means every locale.
///
/// NOTHING HERE IS EVER SEEDED. IBANs and SWIFT codes are live payment
/// destinations, and a placeholder that reaches production sends a donor's
/// transfer nowhere. Rows are entered from the dashboard against official
/// documentation only.
model BankAccount {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  slug     String   @unique
  name     String
  branch   String?
  swift    String?
  holder   String
  logo     String?
  locales  String[] @default([])
  order    Int      @default(0)
  isActive Boolean  @default(true)

  translations BankAccountTranslation[]
  currencies   BankAccountCurrency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// One currency held on an account, with its own number and IBAN.
model BankAccountCurrency {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  bankAccountId String  @db.ObjectId
  /// ISO 4217.
  code          String
  accountNo     String?
  extNo         String?
  iban          String?

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
}

/// Only the words are translated. Account numbers, IBANs and SWIFT codes are
/// identifiers rather than language, and stay on the parent row alone.
model BankAccountTranslation {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  bankAccountId String  @db.ObjectId
  locale        String
  name          String
  branch        String?
  holder        String?

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([bankAccountId, locale])
}

/// Urgent campaign banner, with an expiry so it cannot outlive its emergency.
///
/// `campaignId` is a soft reference rather than a relation: a relation needs a
/// back-field on `Campaign`, and no existing model in this schema is modified.
/// A banner also outlives the campaign it points at — it stays on the record
/// after that campaign is archived.
model UrgentBanner {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  slug              String    @unique
  title             String
  description       String?
  image             String?
  ctaLabel          String?
  ctaUrl            String?
  campaignId        String?   @db.ObjectId
  /// Price chips on the banner, USD; `amountLabels` names them in the same order.
  suggestedAmounts  Int[]     @default([])
  amountLabels      String[]  @default([])
  /// The one-line strip above the photograph — a verse, a hadith, a slogan.
  kicker            String?
  ctaSecondaryLabel String?
  ctaSecondaryUrl   String?
  /// Where on the site it shows: `"<page>:<slot>"` pairs from
  /// `lib/minbar/banner-placements.ts`. Empty = nowhere.
  placements        String[]  @default([])
  /// Look: `red` | `navy` | `gold` | `green`; copy on the `start` or `end` side.
  tone              String    @default("red")
  textSide          String    @default("start")
  /// Sort order within a slot, ascending — set by drag-and-drop on the list.
  priority          Int       @default(0)
  locales           String[]  @default([])
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean   @default(true)

  translations UrgentBannerTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
}

model UrgentBannerTranslation {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  urgentBannerId    String   @db.ObjectId
  locale            String
  title             String
  description       String?
  ctaLabel          String?
  kicker            String?
  ctaSecondaryLabel String?
  amountLabels      String[] @default([])

  urgentBanner UrgentBanner @relation(fields: [urgentBannerId], references: [id], onDelete: Cascade)

  @@unique([urgentBannerId, locale])
}

/// Frequently asked questions. `page` scopes an entry to one page; null shows it
/// wherever FAQs are rendered.
model Faq {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  question String
  answer   String
  page     String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  translations FaqTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, isActive, order])
}

model FaqTranslation {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  faqId    String @db.ObjectId
  locale   String
  question String
  answer   String

  faq Faq @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
}

/**
 * ===================== SUPER CATEGORIES =====================
 */

/// What a `SuperCategoryItem` points at.
///
/// The referenced row is addressed by id rather than by a Prisma relation: a
/// two-sided m-n relation per kind would mean adding a mirrored scalar array to
/// seven existing models (MongoDB has no join table), and seven relations
/// between the same pair of models then need explicit names on both ends. One
/// pointer table costs one extra query per kind on read and keeps every content
/// model untouched. Rows whose target has since been deleted are skipped by the
/// reader rather than cascading.
enum SuperCategoryItemKind {
  CAMPAIGN
  POST
  VIDEO
  PLAYLIST
  COURSE
  REPORT
  BOOKLET
}

/// What a block renders.
///
/// The seven plural kinds render the super category's linked items of that kind
/// as a grid. `TEXT` is a free block — eyebrow, heading, body and a link, which
/// is what a press mention or an explanatory panel needs. `VIDEO` embeds one
/// film by its YouTube id. `PLAYLIST_EPISODES` renders the episodes of the one
/// playlist named by `refId`, which is a different thing from a grid of
/// playlists.
enum SuperCategoryBlockKind {
  CAMPAIGNS
  POSTS
  VIDEOS
  PLAYLISTS
  COURSES
  REPORTS
  BOOKLETS
  TEXT
  VIDEO
  PLAYLIST_EPISODES
}

/// A themed landing page that gathers content of every kind.
///
/// A `Category` groups campaigns and nothing else. A super category is the
/// programme around them: it carries its own page — hero, verse, wordmark,
/// accent colour, calls to action — and links campaigns, articles, videos,
/// playlists, courses, reports and booklets, in an order an editor chooses.
/// ʿIbādan Lanā (`/projects/ibadan-lana`) was such a page hand-written in JSX
/// with its copy in the i18n bundle; it is now a row here.
///
/// The page's shape is `blocks`, so an editor can add a press panel or drop the
/// film without a deploy. Arabic lives on this row and every other language in
/// `SuperCategoryTranslation`, the same split every other content model uses.
model SuperCategory {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  slug String @unique

  // ── Hero, Arabic master copy ──
  title    String
  subtitle String?
  /// The paragraph under the heading.
  intro    String?

  /// The verse the page opens with. Always shown in Arabic, whatever the
  /// edition — `verseTranslation` is the translation of the meaning and is what
  /// changes per locale.
  verseArabic      String?
  verseTranslation String?
  verseAttribution String?

  // ── Customisation ──
  heroImage        String?
  /// The programme's wordmark. A locale may override it in its translation row
  /// when the lockup is script-specific.
  logoImage        String?
  /// Hero ground, as a CSS colour. Everything else on the page is the site palette.
  accentColor      String?
  /// A film embedded in the hero beside the copy.
  heroVideoId      String?
  /// Locales the hero film is shown in; empty means every locale. An Arabic
  /// recording with no subtitled cut should not be played at a reader who
  /// cannot follow it.
  heroVideoLocales String[] @default([])

  ctaPrimaryLabel   String?
  ctaPrimaryHref    String?
  ctaSecondaryLabel String?
  ctaSecondaryHref  String?
  ctaTertiaryLabel  String?
  ctaTertiaryHref   String?

  // ── Search ──
  metaTitle       String?
  metaDescription String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  blocks       SuperCategoryBlock[]
  items        SuperCategoryItem[]
  translations SuperCategoryTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model SuperCategoryTranslation {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  superCategoryId String @db.ObjectId
  locale          String

  title            String
  subtitle         String?
  intro            String?
  verseTranslation String?
  verseAttribution String?
  /// Per-locale wordmark; falls back to the parent's when empty.
  logoImage        String?

  ctaPrimaryLabel   String?
  ctaSecondaryLabel String?
  ctaTertiaryLabel  String?

  metaTitle       String?
  metaDescription String?

  superCategory SuperCategory @relation(fields: [superCategoryId], references: [id], onDelete: Cascade)

  @@unique([superCategoryId, locale])
}

/// One section of a super category's page, in the order it is rendered.
model SuperCategoryBlock {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  superCategoryId String                 @db.ObjectId
  kind            SuperCategoryBlockKind

  /// Anchor id, so a hero call to action can jump to this block.
  anchor    String?
  eyebrow   String?
  title     String?
  subtitle  String?
  body      String?
  linkLabel String?
  linkUrl   String?
  image     String?
  /// `VIDEO` blocks only.
  youtubeId String?
  /// `PLAYLIST_EPISODES` blocks only — the playlist whose episodes are shown.
  refId     String? @db.ObjectId
  /// Caps how many linked items a grid block renders; null renders them all.
  maxItems  Int?

  order    Int     @default(0)
  isActive Boolean @default(true)

  translations  SuperCategoryBlockTranslation[]
  superCategory SuperCategory                   @relation(fields: [superCategoryId], references: [id], onDelete: Cascade)

  @@index([superCategoryId, order])
}

model SuperCategoryBlockTranslation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  blockId String @db.ObjectId
  locale  String

  eyebrow   String?
  title     String?
  subtitle  String?
  body      String?
  linkLabel String?

  block SuperCategoryBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, locale])
}

/// A pointer from a super category to one row of one content model.
model SuperCategoryItem {
  id              String                @id @default(auto()) @map("_id") @db.ObjectId
  superCategoryId String                @db.ObjectId
  kind            SuperCategoryItemKind
  /// Id of the referenced Campaign / Post / Video / VideoPlaylist / Course /
  /// Report / Booklet.
  refId           String                @db.ObjectId
  order           Int                   @default(0)

  superCategory SuperCategory @relation(fields: [superCategoryId], references: [id], onDelete: Cascade)

  @@unique([superCategoryId, kind, refId])
  @@index([superCategoryId, kind, order])
}
