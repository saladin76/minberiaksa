generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/**
 * ===================== AUTH =====================
 */

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  purpose   String   @default("VERIFY_EMAIL")
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

/**
 * ===================== USER =====================
 */

model User {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  /// @deprecated Prefer countryName + countryCode; kept for legacy receipts / data
  country               String?
  countryCode           String?
  countryName           String?
  region                String?
  city                  String?
  phone                 String?
  birthdate             String?
  gender                String?
  profileCompletionSeen Boolean   @default(false)
  role                  Role      @default(DONOR)
  preferredLang         String? // locale from first donation (ar, en, fr) for emails/SMS

  /// Section keys for Role.STAFF — see lib/dashboard/permissions.ts; ignored for ADMIN
  dashboardPermissions String[] @default([])

  /// Microsoft Clarity user identifier — set by an admin from the user profile dialog
  /// so the session-replay/heatmap dashboard can be filtered to this donor on demand.
  /// Editable by admins only; never exposed to the donor themselves.
  clarityId String?

  /// Donor-controlled notification preferences. Both default on; donors can
  /// opt out individually from the profile settings page. Transactional
  /// receipts/confirmations are out of scope — these only gate marketing/updates.
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  donations     Donation[]
  subscriptions Subscription[]
  comments      Comment[]
  cartItems     CartItem[]
  messages      Message[]
  creditCards   CreditCard[]
}

/**
 * ===================== CREDIT CARDS =====================
 */

model CreditCard {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardNumber     String // AES-256 encrypted full card number
  cardType       String // "visa" | "mastercard" | "amex" | "troy" | "unknown"
  expiryDate     String // MM/YY stored as-is
  cvc            String // bcrypt-hashed
  cardholderName String?

  isDefault Boolean @default(false)
  nickname  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/**
 * ===================== AUDIT LOG (dashboard activity) =====================
 */

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime @default(now())
  actorId    String?  @db.ObjectId
  actorName  String?
  actorRole  String
  action     String
  messageAr  String
  messageEn  String?
  entityType String?
  entityId   String?
  metadata   Json?
  /// TEAM: actions by ADMIN/STAFF — DONOR: actions by donors (e.g. donations, profile)
  stream     String
}

/**
 * ===================== CONTACT MESSAGES =====================
 */

model Message {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  subject      MessageSubject? @default(GENERAL)
  body         String          @db.String
  locale       String // ar, en, fr - language when sent
  userId       String?         @db.ObjectId // optional: guest can send without account
  guestName    String?
  guestEmail   String?
  /// The number the sender asked to be reached on FOR THIS MESSAGE. Unlike guestName/guestEmail
  /// it is kept for signed-in senders too — a registered donor may want the reply on a different
  /// number than the one on their profile. Before this column existed the contact form smuggled
  /// it into `body` as a trailing "Phone: …" line, which the inbox still parses for old rows.
  contactPhone String?
  createdAt    DateTime        @default(now())

  // Inbox triage state. All of these are null on arrival: unread and unanswered.
  /// Set the first time an admin opens the message in /dashboard/inbox.
  readAt        DateTime?
  /// Set when an admin actually answers — or marks it answered by hand.
  repliedAt     DateTime?
  repliedVia    MessageReplyChannel?
  /// Who answered. Plain scalars, not a relation: the inbox only ever displays them, and a
  /// relation here would put a back-reference on User for something never queried from that side.
  repliedById   String?              @db.ObjectId
  repliedByName String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum MessageReplyChannel {
  EMAIL
  WHATSAPP
  /// Answered somewhere this app cannot see (phone call, in person, another inbox).
  MANUAL
}

enum MessageSubject {
  COMPLAINT
  DONATION_ISSUE
  CAMPAIGN_SUPPORT
  PARTNERSHIP
  VOLUNTEERING
  GENERAL
}

enum Role {
  ADMIN
  DONOR
  STAFF
}

/**
 * ===================== USER BADGES (GROUPS) =====================
 */
// Badges are computed from criteria; no direct User-Badge relation stored.
// Criteria types: TOTAL_LAST_N_MONTHS, ANY_SPAN_N_MONTHS, MONTHLY_ACTIVE_RANGE, TOTAL_LIFETIME, DONATION_COUNT_MIN

model Badge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String // default name (e.g. Arabic)
  color     String   @default("#3b82f6") // hex
  criteria  Json // { type, amountMinUSD?, amountMaxUSD?, months?, count? }
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations BadgeTranslation[]
}

model BadgeTranslation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  badgeId String @db.ObjectId
  locale  String // ar, en, fr
  name    String

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([badgeId, locale])
}

/**
 * ===================== CATEGORY =====================
 */

model Category {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Arabic (default)
  name        String  @unique
  description String?

  /// URL slug for human-friendly category links (unique across categories)
  slug String? @unique

  image          String?
  icon           String?
  order          Int?
  /// Total shown publicly = baselineAmount + settled donation items. See Campaign.currentAmount.
  currentAmount  Float   @default(0)
  /// Offline/legacy money entered by hand; protected from donation-derived recomputes.
  baselineAmount Float   @default(0)

  /// Archive flag. Toggling this from the dashboard cascades to every
  /// member Campaign — archiving the category archives all its campaigns,
  /// re-activating reverses it. Pre-existing categories may have this
  /// field unset; treat unset as active when filtering.
  isActive Boolean? @default(true)

  /// Inverse side of the Campaign ↔ Category many-to-many relation. Prisma+MongoDB
  /// models implicit m2m by mirroring scalar ObjectId[] arrays on each side. This
  /// is maintained by Prisma whenever campaigns are connected/disconnected.
  campaignIds String[]   @db.ObjectId
  campaigns   Campaign[] @relation(fields: [campaignIds], references: [id])

  /// ── The category's own landing page ──
  /// Every category is published as a project page in the shape of
  /// `Minbar/مشروع ترميم منازل القدس.dc.html`: a hero with a film, a figures
  /// band, the values it stands on, its campaigns as donate cards, a donation
  /// box, three explanatory cards and its achievements in video. Each part is
  /// hidden when its fields are empty, so a category with nothing but a name
  /// still renders — as the hero and its campaigns.
  ///
  /// `image` stays the card photograph used in listings; `heroImage` is the
  /// wide one behind the page's own hero, which is a different crop.
  heroImage    String?
  /// A YouTube URL or bare id; the hero shows the film beside the copy.
  heroVideoUrl String?
  /// The paragraph under the page's heading.
  heroLead     String?
  /// Label of the hero's button; it scrolls to the campaigns.
  ctaLabel     String?

  /// The figures band: "45 homes restored" of "100 homes targeted". The bar
  /// under them is done/goal, and the whole band is skipped when goal is unset.
  statDoneValue Int?
  statDoneLabel String?
  statGoalValue Int?
  statGoalLabel String?

  /// Heading above the campaign grid.
  projectsTitle String?

  /// The donation box at the foot of the page.
  ///
  /// A donation is always made TO A CAMPAIGN: the cart stores campaign slugs and
  /// the order pipeline resolves them (lib/minbar/checkout.ts, toOrderItems), so a
  /// row that named only a category would be dropped at checkout. The box therefore
  /// donates to one campaign of this category — the one named here, or the highest
  /// priority campaign in it when this is unset.
  donateCampaignId String? @db.ObjectId
  donateTitle      String?
  donateNote       String?
  /// Quick amounts in USD. Empty falls back to the site's defaults.
  suggestedAmounts Int[]   @default([])

  /// "Achievements in video" — ids of `Video` rows (type ACHIEVEMENT) shown in
  /// the rail at the end of the page, in this order. Pointers rather than a
  /// relation: a video belongs to the library, not to one category, and a row
  /// that is later deleted or unpublished simply stops appearing.
  achievementsTitle   String?
  achievementVideoIds String[] @db.ObjectId

  values    CategoryValue[]
  infoCards CategoryInfoCard[]

  donationItems             DonationCategoryItem[]
  subscriptionCategoryItems SubscriptionCategoryItem[]
  translations              CategoryTranslation[]
}

/// One cell of the "what this category stands on" strip — a short phrase.
model CategoryValue {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String @db.ObjectId
  label      String
  order      Int    @default(0)

  category     Category                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations CategoryValueTranslation[]

  @@index([categoryId, order])
}

model CategoryValueTranslation {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  valueId String @db.ObjectId
  locale  String
  label   String

  value CategoryValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, locale])
}

/// One of the explanatory cards — "why", "what we do", "the impact".
model CategoryInfoCard {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String @db.ObjectId
  /// Which of the drawn icons to show; see `CATEGORY_CARD_ICONS`.
  icon       String @default("alert")
  title      String
  body       String
  order      Int    @default(0)

  category     Category                      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations CategoryInfoCardTranslation[]

  @@index([categoryId, order])
}

model CategoryInfoCardTranslation {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  cardId String @db.ObjectId
  locale String
  title  String
  body   String

  card CategoryInfoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, locale])
}

model CategoryTranslation {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String @db.ObjectId
  locale     String // en, fr, ...

  name        String
  description String?

  /// The landing page's own copy in this language. Every one is optional and
  /// falls back to the Arabic on the parent row.
  heroLead          String?
  ctaLabel          String?
  statDoneLabel     String?
  statGoalLabel     String?
  projectsTitle     String?
  donateTitle       String?
  donateNote        String?
  achievementsTitle String?

  /// Optional per-locale URL slug. When set, takes precedence over the base Category.slug
  /// for this locale. Uniqueness within a locale is enforced at write time by
  /// generateUniqueLocaleSlug — Prisma+MongoDB doesn't model partial unique indexes well.
  slug String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

/**
 * ===================== HERO SLIDES =====================
 */

model Slide {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  title        String // Arabic default
  description  String?
  image        String?
  showButton   Boolean            @default(true)
  buttonText   String?
  buttonLink   String?
  isActive     Boolean            @default(true)
  order        Int                @default(0)
  translations SlideTranslation[]
}

model SlideTranslation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  slideId     String  @db.ObjectId
  locale      String
  title       String
  description String?
  buttonText  String?
  slide       Slide   @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@unique([slideId, locale])
}

/**
 * ===================== CAMPAIGN =====================
 */

model Campaign {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Arabic (default)
  title       String
  description String

  /// URL slug for human-friendly campaign links (unique across campaigns)
  slug String? @unique

  targetAmount   Float
  /// Total shown publicly = baselineAmount + settled donation items.
  /// NEVER recompute this from donations alone — that silently destroys baselineAmount.
  currentAmount  Float    @default(0)
  /// Money raised OUTSIDE the site (cash, bank transfer, a legacy system) that an admin
  /// entered by hand. Kept separate so recomputing from donation rows can't wipe it.
  baselineAmount Float    @default(0)
  images         String[]
  videoUrl       String?
  isActive       Boolean  @default(true)
  /// Soft-delete flag. The dashboard "delete" action sets this to true and
  /// flips isActive to false; listing endpoints filter it out so the campaign
  /// disappears from public + dashboard surfaces. We keep the row (and all
  /// DonationItem / SubscriptionItem relations) so historical donation totals,
  /// receipts, and audit trails stay intact. Pre-existing rows may have the
  /// field unset entirely — treat unset as not deleted when filtering.
  isDeleted      Boolean? @default(false)
  priority       Int?

  /// { "amounts": number[], "byCurrency"?: Record<string, number[]> } — quick-pick donation amounts; omit/null uses app defaults
  suggestedDonations Json?

  /// { "amounts": number[], "byCurrency"?: Record<string, number[]> } — per-campaign override for team-support quick-pick amounts; omit/null falls back to GlobalSettings, then hardcoded defaults
  suggestedTeamSupport Json?

  /// FIXED = show goal & progress bar; OPEN = open-ended (no fixed target UI)
  goalType             String @default("FIXED")
  /// AMOUNT = donor enters amount; SHARES = سهوم (share price × number of shares)
  fundraisingMode      String @default("AMOUNT")
  /// Price of one share in USD when fundraisingMode is SHARES
  sharePriceUSD        Float?
  /// { "counts": number[] } — quick-pick share counts for سهوم campaigns
  suggestedShareCounts Json?
  /// Per-locale custom names for the "share" unit on SHARES-mode campaigns.
  /// Shape: { "<locale>": { "singular": string, "plural": string } }
  /// e.g. { "ar": { "singular": "خروف", "plural": "خراف" }, "en": { "singular": "sheep", "plural": "sheep" } }
  /// When unset (or a specific locale missing), the UI falls back to the generic
  /// "share"/"shares" translation strings. Lets admins re-label the donation unit
  /// per campaign without forking the translation files.
  shareLabels          Json?

  /// Implicit many-to-many — a campaign can belong to one or more categories.
  /// Prisma+MongoDB stores the relation as mirrored ObjectId[] arrays on each side.
  categoryIds String[]   @db.ObjectId
  categories  Category[] @relation(fields: [categoryIds], references: [id])

  /// Per-category priorities for ordering on each category page.
  /// Shape: { "<categoryId>": number } — lower number = higher priority; absent key = unprioritized.
  /// Replaces the single `categoryPriority` field which only made sense when a
  /// campaign belonged to exactly one category.
  categoryPriorities Json?

  updates           Update[]
  comments          Comment[]
  cartItems         CartItem[]
  donations         DonationItem[]
  subscriptionItems SubscriptionItem[]
  translations      CampaignTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignTranslation {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String @db.ObjectId
  locale     String // en, fr, ...

  title       String
  description String

  /// Optional locale-specific cover image. When set, replaces images[0] (cover) for this locale.
  image    String?
  /// Optional locale-specific video URL. When set, replaces the campaign-level videoUrl for this locale.
  videoUrl String?

  /// Optional per-locale URL slug. When set, takes precedence over the base Campaign.slug
  /// for this locale. Uniqueness within a locale is enforced at write time.
  slug String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, locale])
}

/**
 * ===================== CAMPAIGN UPDATES =====================
 */

model Update {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Arabic
  title       String
  description String

  image    String?
  videoUrl String?

  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  translations UpdateTranslation[]

  createdAt DateTime @default(now())
}

model UpdateTranslation {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  updateId String @db.ObjectId
  locale   String

  title       String
  description String

  update Update @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([updateId, locale])
}

/**
 * ===================== DONATIONS =====================
 */

model Referral {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  code             String   @unique // e.g. "ahmed", "tiktok1"
  name             String? // optional label for dashboard
  cookieExpiryDays Int      @default(30) // 0 = unlimited (cookie lasts ~10 years)
  createdAt        DateTime @default(now())

  donations     Donation[]
  subscriptions Subscription[]
}

model Donation {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  amount      Float
  amountUSD   Float?
  currency    String  @default("USD")
  teamSupport Float   @default(0)
  coverFees   Boolean @default(false)
  fees        Float   @default(0)
  totalAmount Float

  status DonationStatus @default(PAID)
  locale String?

  // Payment provider tracking (PayFor Sanal POS)
  provider               String? // e.g. "PAYFOR"
  providerOrderId        String? // PayFor OrderId (we use donation id by default)
  providerTxnType        String? // e.g. "Auth"
  providerProcReturnCode String?
  providerTxnResult      String? // "Success" / "Failed"
  providerAuthCode       String?
  providerHostRefNum     String?
  providerErrorMessage   String?
  providerRaw            Json?

  donorId          String    @db.ObjectId
  donor            User      @relation(fields: [donorId], references: [id])
  /// ISO 3166-1 alpha-2 snapshot from donor User.countryCode at donation time
  donorCountryCode String?
  referralId       String?   @db.ObjectId
  referral         Referral? @relation(fields: [referralId], references: [id])

  subscriptionId String?       @db.ObjectId
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  /// Stripe invoice `billing_reason` for subscription donations — the authoritative
  /// "is this the signup charge or an automatic renewal?" marker.
  /// "subscription_create" = first charge, "subscription_cycle" = automatic renewal.
  /// Null on one-time donations and on legacy rows created before this was recorded.
  billingReason  String?

  comment       String?
  /// Optional only to tolerate legacy / pre-enforcement rows that exist in
  /// MongoDB without the field set (Prisma+MongoDB doesn't error on read for
  /// unset enums on optional fields — but it DOES error if a required enum
  /// is missing). Every NEW write goes through paths that always set CARD or
  /// PAYPAL, so this should only ever be null for historical donations.
  paymentMethod PaymentMethod?
  cardDetails   CardDetails?

  /// UTM/ads/GA/Meta snapshot from client at checkout (JSON). Server conversions use the same donation id as event_id.
  attribution                  Json?
  /// Set when Meta CAPI + GA4 MP "Donate" success events were sent for this row (idempotent).
  conversionEventsSentAt       DateTime?
  /// Set when Meta CAPI "DonateFailed" event was sent for this row (idempotent). Feeds lookalike audiences for almost-donors.
  conversionFailedEventsSentAt DateTime?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  items         DonationItem[]
  categoryItems DonationCategoryItem[]
  comments      Comment[]
}

model Subscription {
  id     String             @id @default(auto()) @map("_id") @db.ObjectId
  status SubscriptionStatus @default(ACTIVE)

  amount        Float
  amountUSD     Float?
  currency      String        @default("USD")
  teamSupport   Float         @default(0)
  coverFees     Boolean       @default(false)
  paymentMethod PaymentMethod
  cardDetails   CardDetails?

  // PayFor recurring support (requires bank-provided token/reference transaction model)
  payforToken     String?
  payforMaskedPan String?
  payforExpiry    String? // MMYY (if bank requires it alongside token)

  donorId    String    @db.ObjectId
  donor      User      @relation(fields: [donorId], references: [id])
  referralId String?   @db.ObjectId
  referral   Referral? @relation(fields: [referralId], references: [id])

  nextBillingDate DateTime?
  lastBillingDate DateTime?

  createdAt DateTime @default(now())

  items         SubscriptionItem[]
  categoryItems SubscriptionCategoryItem[]
  donations     Donation[]
}

model SubscriptionItem {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String @db.ObjectId
  campaignId     String @db.ObjectId

  amount     Float
  amountUSD  Float?
  /// When set, line item was a سهوم (shares) purchase — mirrors DonationItem.shareCount.
  /// Three creation paths (donations, stripe/intent, cart/payment) already spread this in
  /// conditionally; without the field Prisma threw PrismaClientValidationError inside the
  /// transaction, rolling back the whole thing — no subscription AND no donation, just a 500.
  shareCount Int?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  campaign     Campaign     @relation(fields: [campaignId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionCategoryItem {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionId String @db.ObjectId
  categoryId     String @db.ObjectId

  amount    Float
  amountUSD Float?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonationItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  donationId String @db.ObjectId
  campaignId String @db.ObjectId

  amount     Float
  amountUSD  Float?
  /// When set, line item was a سهوم (shares) purchase
  shareCount Int?

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonationCategoryItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  donationId String @db.ObjectId
  categoryId String @db.ObjectId

  amount    Float
  amountUSD Float?

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum DonationStatus {
  PAID
  FAILED
}

enum PaymentMethod {
  CARD
  PAYPAL
}

//asd
type CardDetails {
  cardNumber     String
  expiryDate     String
  cvv            String
  cardholderName String
}

/**
 * ===================== COMMENTS & CART =====================
 */

model Comment {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  text String

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  donationId String?   @db.ObjectId
  donation   Donation? @relation(fields: [donationId], references: [id])

  /// Optional: a comment left on a DONATION has no single campaign (a donation can span
  /// several campaigns, or be category-only). Campaign comments always set it.
  campaignId String?   @db.ObjectId
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  createdAt DateTime @default(now())
}

model CartItem {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String @db.ObjectId
  userId     String @db.ObjectId

  amount     Float
  amountUSD  Float?
  currency   String @default("USD")
