model PostTranslation {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  postId String @db.ObjectId
  locale String

  title       String?
  description String?
  content     String?
  image       String?

  /// Optional per-locale URL slug. When set, takes precedence over Post.slug
  /// for this locale. Uniqueness within a locale is enforced at write time.
  slug String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}

model LiveDonationTicker {
  id String @id @default(auto()) @map("_id") @db.ObjectId

