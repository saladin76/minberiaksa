model CommunicationCampaign {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  channel            String // WHATSAPP | EMAIL | SMS
  purpose            String    @default("MARKETING") // MARKETING | UTILITY | TRANSACTIONAL | AUTHENTICATION
  audienceSegmentKey String?
  templateGroupId    String?
  senderRoutingMode  String    @default("AUTO") // AUTO | FIXED
  status             String    @default("DRAFT") // DRAFT | REVIEW | APPROVED | SCHEDULED | SENDING | SENT | CANCELLED | FAILED
  scheduledAt        DateTime?
  approvedBy         String?   @db.ObjectId
  approvedAt         DateTime?
  sentCount          Int       @default(0)
  deliveredCount     Int       @default(0)
  readCount          Int       @default(0)
  failedCount        Int       @default(0)
  repliedCount       Int       @default(0)
  clickedCount       Int       @default(0)
  donationCount      Int       @default(0)
  revenue            Float     @default(0)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([channel, status])
  @@index([status])
}

model CommunicationDelivery {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  channel                String // WHATSAPP | EMAIL | SMS
  provider               String? // META_WHATSAPP | TWILIO | SENDGRID | NETGSM | CUSTOM
  senderId               String?   @db.ObjectId
  campaignId             String?   @db.ObjectId
  templateId             String?
  templateName           String?
  recipientUserId        String?   @db.ObjectId
  recipientPhone         String?
  recipientEmail         String?
  recipientName          String?
  locale                 String?
  purpose                String    @default("TRANSACTIONAL") // MARKETING | UTILITY | TRANSACTIONAL | AUTHENTICATION
  origin                 String    @default("SYSTEM") // MANUAL | CAMPAIGN | TRIGGER | TEST | REACTIVATION | SYSTEM
  // Lifecycle: DRAFT | QUEUED | RENDERED | SKIPPED | SENT_TO_PROVIDER | SENT |
  // DELIVERED | READ | OPENED | CLICKED | REPLIED | FAILED | BOUNCED | UNSUBSCRIBED | CANCELLED
  status                 String    @default("DRAFT")
  renderedSubject        String?
  renderedBody           String?
  variables              Json?
  providerMessageId      String?
  providerConversationId String?
  errorMessage           String?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  readAt                 DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  repliedAt              DateTime?
  failedAt               DateTime?
  // Retry linkage. A retry is a NEW row pointing back at the attempt it re-sends, never an edit of
  // the original: the first failure is evidence, and rewriting it would silently move the historical
  // failure-rate figures. `retriedAt` is stamped on the ORIGINAL once a retry actually reaches the
  // provider, which is what stops the same message being sent twice.
  // Both are optional — MongoDB documents written before this existed have neither field, and a
  // required column would make every one of them unreadable.
  retryOfDeliveryId      String?   @db.ObjectId
  retriedAt              DateTime?
  createdBy              String?   @db.ObjectId
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([campaignId])
  @@index([channel, status])
  @@index([recipientUserId])
  @@index([providerMessageId])
}

model CommunicationProviderEvent {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  deliveryId        String?   @db.ObjectId
  channel           String
  provider          String
  eventType         String
  providerMessageId String?
  senderId          String?   @db.ObjectId
  recipient         String?
  payloadSanitized  Json?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  status            String?
  errorMessage      String?
  idempotencyKey    String    @unique
  createdAt         DateTime  @default(now())

  @@index([deliveryId])
  @@index([providerMessageId])
}

/// A reusable audience list — a custom manual list or a TEST list used to try
/// campaigns/templates before real sending. Automatic language segments are computed live and are
/// NOT stored here. Never seeded with demo data.
model CommunicationAudienceList {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  /// "CUSTOM" | "TEST".
  type        String    @default("CUSTOM")
  /// "ACTIVE" | "ARCHIVED".
  status      String    @default("ACTIVE")
  locale      String?
  /// Channels this list targets: any of "WHATSAPP" | "EMAIL" | "SMS".
  channels    String[]
  createdBy   String?   @db.ObjectId
  createdByName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  metadata    Json?

  @@index([type, status])
  @@index([status])
}

/// One member of a CommunicationAudienceList. DONOR members reference a real User (contact data is
/// read live from the donor). TEST_CONTACT members hold ad-hoc contact info used ONLY for test sends
/// — they never become donors and never appear in donation reports or normal donor counts.
model CommunicationAudienceMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  listId      String   @db.ObjectId
  userId      String?  @db.ObjectId
  /// "DONOR" | "TEST_CONTACT".
  contactType String   @default("DONOR")
  name        String?
  email       String?
  phone       String?
  locale      String?
  /// "ACTIVE" | "REMOVED".
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listId, status])
  @@index([userId])
}

/// Associates a CommunicationCampaign with a real tracking link (from the existing Link Generator /
/// MarketingCampaignLink collection) so donations can be attributed back to the campaign via the
/// donation `attribution` UTM snapshot. Never fabricates attribution — it only records the link + the
/// UTM values used, and reports match real donations against them.
model CommunicationCampaignTrackingLink {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId  String   @db.ObjectId
  /// Id / urlHash of the underlying MarketingCampaignLink (raw collection), when created via the generator.
  linkId      String?
  url         String
  /// "whatsapp" | "email" | "sms" — auto-selected from the campaign channel.
  source      String
  medium      String   @default("communication")
  /// The value used as utm_campaign (the CommunicationCampaign id) — the campaign-level match key.
  utmCampaign String
  locale      String?
  templateId  String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdBy   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  metadata    Json?

  @@index([campaignId, status])
}
