/* ===================== OPERATIONS PLATFORM ===================== */

model OperationSeason {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  focus         String?
  status        String   @default("PLANNING")
  periodLabel   String?
  startDate     DateTime?
  endDate       DateTime?
  requiredItems Int      @default(0)
  readyItems    Int      @default(0)
  progress      Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model OperationWeeklyTheme {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  seasonId    String?  @db.ObjectId
  weekLabel   String
  theme       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  order       Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seasonId])
  @@index([startDate])
  @@index([order])
}

model ContentPlan {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  seasonId       String?  @db.ObjectId
  weeklyThemeId  String?  @db.ObjectId
  title          String
  theme          String?
  status         String   @default("PLANNING")
  periodLabel    String?
  startDate      DateTime?
  endDate        DateTime?
  ownerId        String?  @db.ObjectId
  requiredItems  Int      @default(0)
  publishedItems Int      @default(0)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([seasonId])
  @@index([weeklyThemeId])
  @@index([status])
  @@index([ownerId])
}

model ContentItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  planId         String?  @db.ObjectId
  seasonId       String?  @db.ObjectId
  title          String
  type           String
  status         String   @default("IDEA")
  channel        String?
  language       String?
  dueDate        DateTime?
  publishAt      DateTime?
  assetUrl       String?
  copyText       String?  @db.String
  marketingNotes String?  @db.String
  campaignLinkId String?  @db.ObjectId
  metadata       Json?
  createdById    String?  @db.ObjectId
  assignedToId   String?  @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([planId])
  @@index([seasonId])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([dueDate])
  @@index([assignedToId])
}

model ContentTask {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  itemId      String?   @db.ObjectId
  title       String
  ownerId     String?   @db.ObjectId
  ownerLabel  String?
  status      String    @default("TODO")
  dueDate     DateTime?
  completedAt DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([itemId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
}
